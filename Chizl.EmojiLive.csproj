<Project Sdk="Microsoft.NET.Sdk">
		<PropertyGroup>
				<TargetFrameworks>
						netstandard2.0;netstandard2.1;net471;net472;net48;net481;net8.0;net9.0;net10.0
				</TargetFrameworks>
				<ImplicitUsings>disable</ImplicitUsings>
				<Nullable>disable</Nullable>
				<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
				<GenerateDocumentationFile>False</GenerateDocumentationFile>
		</PropertyGroup>

		<PropertyGroup>
				<Authors>Chizl</Authors>
				<PackageId>Chizl.EmojiLive</PackageId>
				<Company>Chizl.com</Company>
				<Copyright>© 2025 chizl.com</Copyright>
				<PackageTags>fully-qualified;emoji;library;in-console;on-desktop;core;standard;framework;no-deps</PackageTags>
				<AssemblyVersion>6.0.0.0</AssemblyVersion>
				<!-- Path +1 for each deploy to Nuget. -->
				<Version>6.01.17.1</Version>
				<!-- [Year-2020].Month.Day.HHmm (UTC). -->
				<FileVersion>6.01.17.2120</FileVersion>
				<!-- Uses by audit and system monitors. -->
				<InformationalVersion>6.01.17.2120</InformationalVersion>

				<!-- NuGet Package Metadata -->
				<PackageReadmeFile>README.md</PackageReadmeFile>
				<Description>A comprehensive .NET emoji library providing **4,098 fully-qualified emojis** organized into 10 major groups with detailed metadata and 64x64 PNG image support.</Description>
				<PackageProjectUrl>https://github.com/gavin1970/Chizl.EmojiLive</PackageProjectUrl>
				<RepositoryUrl>https://github.com/gavin1970/Chizl.EmojiLive</RepositoryUrl>
				<RepositoryType>git</RepositoryType>
				<PackageLicenseExpression>MIT</PackageLicenseExpression>
				<PackageIcon>ChizlEmojiLive.png</PackageIcon>
				<PackageReleaseNotes>See https://github.com/gavin1970/Chizl.EmojiLive/releases</PackageReleaseNotes>
				<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
				<ApplicationIcon>EmojiLive.ico</ApplicationIcon>
				<PackageIcon>EmojiLive.png</PackageIcon>
		</PropertyGroup>

		<ItemGroup>
		  <Compile Remove="demos\**" />
		  <EmbeddedResource Remove="demos\**" />
		  <None Remove="demos\**" />
		</ItemGroup>
		
		<ItemGroup>
				<None Include="README.md" Pack="true" PackagePath="\" />
				<None Include="EmojiLive.png" Pack="true" PackagePath="\" />
				<None Include="EmojiLive.ico" Pack="true" PackagePath="\" />
				<None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
		</ItemGroup>

		<ItemGroup>
		  <PackageReference Include="SkiaSharp" Version="3.119.2" PrivateAssets="none" />
		</ItemGroup>
		
		<ItemGroup>
		  <Folder Include="groups\" />
		</ItemGroup>
		
		<ItemGroup>
		  <None Update="README.md" Pack="true" PackagePath="\" />
		</ItemGroup>
</Project>
